# Open WebUI 容器运行期环境变量。

# 当前 compose 不启动 Ollama，本项保留为空，避免误连本机 Ollama。
OLLAMA_BASE_URL=

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN=*

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS=*

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_VERSION_UPDATE_CHECK=false

# 设置默认环境变量
# WEBUI_SECRET_KEY 不在这里明文配置；start.sh 会在首次启动时生成并复用此文件。
WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key

### 数据目录，由 docker-compose named volume 持久化
DATA_DIR=/app/backend/data

# 默认模型已在镜像构建期预置；首次启动优先从数据卷缓存加载，避免联网自动更新。
RAG_EMBEDDING_MODEL_AUTO_UPDATE=False
RAG_RERANKING_MODEL_AUTO_UPDATE=False
WHISPER_MODEL_AUTO_UPDATE=False

### 管理员
WEBUI_ADMIN_EMAIL=admin@ai.marketing.com
WEBUI_ADMIN_PASSWORD=admin
WEBUI_ADMIN_NAME=admin
FORCE_USER_DEFAULT_MODELS=True

### 用户
ENABLE_SIGNUP=False
DEFAULT_USER_ROLE=pending
USER_PERMISSIONS_CHAT_STT=False
USER_PERMISSIONS_CHAT_TTS=False
USER_PERMISSIONS_CHAT_CALL=False
USER_PERMISSIONS_CHAT_CONTROLS=False
USER_PERMISSIONS_CHAT_PARAMS=False
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT=False
USER_PERMISSIONS_CHAT_VALVES=False
USER_PERMISSIONS_FEATURES_API_KEYS=False
ENABLE_API_KEYS=False

### API
# 默认关闭外部 OpenAI 兼容 API，避免没有真实 API Key 时远程测试环境误调用。
# 如需启用，在远程服务器本地 .env 中设置 ENABLE_OPENAI_API=True 并填入真实 OPENAI_API_KEY。
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URL=https://api.moonshot.cn/v1
OPENAI_API_KEY=
DEFAULT_MODELS=kimi-k2.5

### 网络搜索
# 默认关闭网络搜索，避免没有真实 Tavily API Key 时测试环境误调用。
# 如需启用，在远程服务器本地 .env 中设置 ENABLE_WEB_SEARCH=True 并填入真实 TAVILY_API_KEY。
ENABLE_WEB_SEARCH=False
WEB_SEARCH_ENGINE=tavily
TAVILY_API_KEY=
USER_PERMISSIONS_FEATURES_WEB_SEARCH=False
WEB_SEARCH_RESULT_COUNT=3
TAVILY_EXTRACT_DEPTH=basic

### 社区分享
ENABLE_COMMUNITY_SHARING=False

### 用户组权限设置，可参考 config.py中各 USER_PERMISSIONS_* 参数
