# Compose 镜像构建参数
# 宿主机访问端口；容器内部仍监听 8080。
OPEN_WEBUI_PORT=3031

# 本地构建出的 Open WebUI 镜像名和标签。
# 例如构建后得到 my-openwebui-internal:0.1。
OPEN_WEBUI_IMAGE=openwebui-product
WEBUI_DOCKER_TAG=0.1.4

# 可选：构建期下载镜像源。保持注释/空值时，不改变 Dockerfile 默认下载源。
OPEN_WEBUI_ALPINE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
OPEN_WEBUI_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
OPEN_WEBUI_NPM_REGISTRY=https://registry.npmmirror.com
OPEN_WEBUI_PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
OPEN_WEBUI_PYTORCH_CPU_INDEX_URL=
OPEN_WEBUI_PYTORCH_CUDA_INDEX_URL=
OPEN_WEBUI_HF_ENDPOINT=https://hf-mirror.com
OPEN_WEBUI_NLTK_DATA_INDEX_URL=
