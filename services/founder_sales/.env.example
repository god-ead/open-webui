# ⚠ 本文件与 open-webui 根 .env.example 的 Founder Sales 段保持同步（本地开发与部署双份）。
APP_PORT=8050
FOUNDER_SALES_API_KEY=change-me
CHECKPOINT_DB_PATH=./data/runtime/checkpoints.sqlite3
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_API_KEY=change-me
QWEN_SEARCH_MODEL=qwen3.5-plus
QWEN_AGENT_MODEL=qwen3.7-plus
QWEN_FALLBACK_MODEL=qwen3.5-plus
QWEN_TIMEOUT_SECONDS=60
RAG_STORE_PATH=data/sales_rag.sqlite3
FAISS_INDEX_PATH=data/sales_rag.faiss
EMBEDDING_MODEL_PATH=data/model/embedding
RERANKER_MODEL_PATH=
# 推理设备：部署固定为 CPU（ CPU 版 torch，见 requirements.txt）
RAG_DEVICE=cpu
