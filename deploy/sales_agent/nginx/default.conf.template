map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    server_name _;
    absolute_redirect off;

    location = ${PUBLIC_BASE_PATH} {
        return 308 ${PUBLIC_BASE_PATH}/;
    }

    # CRM widget 的默认根地址直接进入认证启动页；成功后再跳转 LibreChat 会话。
    location = ${PUBLIC_BASE_PATH}/ {
        proxy_pass http://founder-sales-librechat:3080/api/auth/crm/entry;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${PUBLIC_BASE_PATH};
    }

    location ^~ ${PUBLIC_BASE_PATH}/ {
        proxy_pass http://founder-sales-librechat:3080/;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${PUBLIC_BASE_PATH};

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cookie_path / ${PUBLIC_BASE_PATH}/;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 0;
    }

    location / {
        default_type text/plain;
        return 404 "Founder-Sales-Agent is available at /sales-agent\n";
    }
}
