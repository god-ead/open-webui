COMPOSE_PROJECT_NAME=sales-agent

# 对外地址和子路径末尾都不要加斜杠
PUBLIC_ORIGIN=http://172.19.52.43:3030
PUBLIC_BASE_PATH=/sales-agent
SALES_AGENT_PORT=3030

NGINX_IMAGE=nginx:1.27-alpine
LIBRACHAT_IMAGE=registry.librechat.ai/danny-avila/librechat:v0.8.7
MONGO_IMAGE=mongo:8.0
FOUNDER_SALES_IMAGE=founder-sales:dev

# LibreChat → founder_sales 的 Bearer 鉴权
FOUNDER_SALES_API_KEY=

# 智能体数据地址（宿主机）
# 存储 checkpoint 数据，读取 RAG 知识库与 embedding/rerank 模型
FOUNDER_SALES_DATA_DIR=/data/app/founder-sales

# 智能体服务配置，founder_sales → DashScope
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_API_KEY=
QWEN_AGENT_MODEL=qwen3.7-plus
QWEN_FALLBACK_MODEL=qwen3.5-plus
QWEN_SEARCH_MODEL=qwen3.5-plus
QWEN_TIMEOUT_SECONDS=60
BUSINESS_TIMEOUT_SECONDS=360

# LibreChat 启动
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# LibreChat 持久化
MONGO_DATA_DIR=/data/app/founder-sales/libre/mongodb
LIBRACHAT_UPLOADS_DIR=/data/app/founder-sales/libre/uploads
LIBRACHAT_LOGS_DIR=/data/app/founder-sales/libre/logs

# # 智能体持久化（容器内）
# CHECKPOINT_DB_PATH=/app/data/runtime/checkpoints.sqlite3
# RAG_STORE_PATH=/app/data/knowledge/sales_rag.sqlite3
# FAISS_INDEX_PATH=/app/data/knowledge/sales_rag.faiss
# EMBEDDING_MODEL_PATH=/app/data/model/embedding

# 未准备/不加载 rerank 模型时必须留空
RERANKER_MODEL_PATH=
# 推理设备：部署固定为 CPU（ CPU 版 torch，见 requirements.txt）
RAG_DEVICE=cpu
