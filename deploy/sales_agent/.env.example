COMPOSE_PROJECT_NAME=sales-agent

# 对外地址和子路径末尾都不要加斜杠
PUBLIC_ORIGIN=http://172.19.52.43:3030
PUBLIC_BASE_PATH=/sales-agent
SALES_AGENT_PORT=3030

# LibreChat Admin Panel：只监听宿主机指定内网地址，并由 Nginx 限制来源。
ADMIN_PANEL_PORT=3031
ADMIN_BIND_IP=172.19.52.43
# 默认仅允许 172.19.52.0–172.19.52.255；如只允许单台设备，填写其具体 IP。
# 设为 0.0.0.0/0 时允许所有 IPv4 来源。
ADMIN_ALLOWED_CIDR=172.19.52.0/24

LIBRECHAT_IMAGE=172.19.52.215:9100/sales-agents/founder-sales-librechat:<指定版本标签>
FOUNDER_SALES_IMAGE=172.19.52.215:9100/sales-agents/founder-sales:<指定版本标签>
ADMIN_PANEL_IMAGE=registry.librechat.ai/clickhouse/librechat-admin-panel:1.0.0
NGINX_IMAGE=nginx:1.27-alpine
MONGO_IMAGE=mongo:8.0

# LibreChat → founder_sales 的 Bearer 鉴权
FOUNDER_SALES_API_KEY=

# 智能体数据地址（宿主机）
# 存储 checkpoint 数据
FOUNDER_SALES_DATA_DIR=/data/app/founder-sales/runtime

# 智能体服务配置，founder_sales → DashScope
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_API_KEY=
QWEN_AGENT_MODEL=qwen3.6-plus
QWEN_VISIT_MODEL=qwen3.6-plus
QWEN_FALLBACK_MODEL=qwen3.5-plus
QWEN_TASK_MODEL_LITE=qwen3.5-plus
QWEN_SEARCH_MODEL=qwen3.5-plus
# 联网搜索模块返回受控错误时，首次请求后的额外重试次数
QWEN_SEARCH_RETRY_COUNT=2
QWEN_TIMEOUT_SECONDS=60
BUSINESS_TIMEOUT_SECONDS=360

# 企业画像 Tool → DashScope，独立于销售主智能体配置
COMPANY_PROFILE_LLM_API_KEY=
COMPANY_PROFILE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COMPANY_PROFILE_LLM_MODEL=qwen3.5-plus
COMPANY_PROFILE_LLM_TIMEOUT_SECONDS=180

# LibreChat 启动
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
ADMIN_PANEL_SESSION_SECRET=

# 本地管理员初始化；留空时由 init-admin.sh 交互询问。
LIBRECHAT_ADMIN_EMAIL=
LIBRECHAT_ADMIN_PASSWORD=

# CRM 认证网关。正式环境必须关闭下方原生登录和注册开关。
CRM_AES_KEY=
CRM_AES_IV=
CRM_TOKEN_MAX_AGE_SECONDS=10
CRM_ALLOWED_ORIGINS=https://founderec.foundertype.com
CRM_AUTH_DEBUG_ERRORS=false
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false

# LibreChat 持久化
MONGO_DATA_DIR=/data/app/founder-sales/libre/mongodb
LIBRACHAT_UPLOADS_DIR=/data/app/founder-sales/libre/uploads
LIBRACHAT_LOGS_DIR=/data/app/founder-sales/libre/logs

# # 智能体持久化（容器内）
# CHECKPOINT_DB_PATH=/app/data/runtime/checkpoints.sqlite3

# 未准备/不加载 rerank 模型时必须留空
RERANKER_MODEL_PATH=
# 推理设备：部署固定为 CPU（ CPU 版 torch，见 requirements.txt）
RAG_DEVICE=cpu
