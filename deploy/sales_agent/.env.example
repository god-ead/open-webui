###############################################################################
# 销售智能体（Sales Agent）环境变量模板
#
# 用法：cp .env.example .env，完成【必填】项并检查【推荐修改】项后启动：
#   docker compose up -d
#
#   - .env 已被 gitignore，可存放密钥。
#   - 对外地址和子路径末尾都不要加斜杠。
#   - 【必填】项与部署环境或外部系统相关，不能使用固定默认值。
#   - 【推荐修改】项已提供参考值，正式部署时应按端口、镜像和数据目录规划调整。
#   - 其余项已提供团队内网默认值，没有明确需求时无需修改。
#
# ⚠ 必填项：
#   PUBLIC_ORIGIN                              销售智能体对外可访问地址
#   ADMIN_BIND_IP                              Admin Panel 端口绑定的本机 IP
#   QWEN_API_KEY                               销售主智能体与企业画像 Tool 共用的 Qwen API Key
#   CRM_AES_KEY / CRM_AES_IV                   CRM 入口凭证解密参数，各16字节
#   CRM_ALLOWED_ORIGINS                        允许发起 CRM 认证的网页来源
#   FOUNDER_SALES_POSTGRES_PASSWORD            checkpoint 数据库密码
# 推荐修改：
#   SALES_AGENT_PORT / ADMIN_PANEL_PORT        宿主机对外端口
#   ADMIN_ALLOWED_CIDR                         Admin Panel 访问白名单
#   LIBRECHAT_IMAGE / FOUNDER_SALES_IMAGE      正式/测试环境业务镜像标签
#   DATA_DIR                                   宿主机数据根目录
###############################################################################

# ── 必填：对外入口与本机网络 ──────────────────────────────────────────
# 【必填】浏览器和 CRM 对外访问地址，包含协议与端口，末尾不加斜杠
PUBLIC_ORIGIN=http://172.19.52.43:3030
# 【必填】Admin Panel 宿主机端口绑定的本机内网 IP
ADMIN_BIND_IP=172.19.52.43

# ── 必填：智能体与 LLM 鉴权 ────────────────────────────────────────────
# 【必填】销售主智能体与企业画像 Tool 共用的 Qwen API Key
QWEN_API_KEY=
# 企业画像 Tool 与销售主智能体使用同一个 Qwen Key，无需重复填写
COMPANY_PROFILE_LLM_API_KEY=${QWEN_API_KEY}

# ── 必填：checkpoint 数据库 ──────────────────────────────────────────────
# 【必填】仅允许使用 URL 安全字符，Compose 会将其拼入 PostgreSQL连接地址
FOUNDER_SALES_POSTGRES_PASSWORD=

# ── 必填：CRM 认证网关 ──────────────────────────────────────────────────
# 【必填】CRM AES-CBC 解密密钥与 IV，均须为 UTF-8 编码各16字节
CRM_AES_KEY=
CRM_AES_IV=
# 【必填】允许发起 CRM 认证的 Origin，多个来源按服务约定填写
CRM_ALLOWED_ORIGINS=https://founderec.foundertype.com,https://founderec.foundertype.com:444,https://founderec.foundertype.com:446

# ── 推荐修改：部署标识与对外端口 ────────────────────────────────────────
# 【推荐修改】宿主机对外端口，占用时换用可用端口
SALES_AGENT_PORT=3030
ADMIN_PANEL_PORT=3031
# 【推荐修改】默认仅允许 172.19.52.0–172.19.52.255；如只允许单台设备，填写其 IP
# 严禁在正式环境使用 0.0.0.0/0
ADMIN_ALLOWED_CIDR=172.19.52.0/24

# ── 推荐修改：业务镜像 ─────────────────────────────────────────────────────
# 【推荐修改】正式/测试环境从 Harbor 选择已验证的版本标签
LIBRECHAT_IMAGE=172.19.52.215:9100/sales-agents/founder-sales-librechat:<指定版本标签>
FOUNDER_SALES_IMAGE=172.19.52.215:9100/sales-agents/founder-sales:<指定版本标签>

# ── 推荐修改：宿主机数据目录 ─────────────────────────────────────────────
# 【推荐修改】根据宿主机目录规划调整，正式环境建议使用绝对路径
DATA_DIR=./data

# ── 推荐按需填写：本地管理员初始化 ────────────────────────────────────
# 留空时由 init-admin.sh 交互询问；非交互初始化时应填写
LIBRECHAT_ADMIN_EMAIL=
LIBRECHAT_ADMIN_PASSWORD=

# ── 默认项：路由、基础镜像与 Admin Panel ──────────────────────────────────────
COMPOSE_PROJECT_NAME=sales-agent
PUBLIC_BASE_PATH=/sales-agent
NGINX_IMAGE=nginx:1.27-alpine
MONGO_IMAGE=mongo:8.0
POSTGRES_IMAGE=postgres:16-alpine
ADMIN_PANEL_IMAGE=registry.librechat.ai/clickhouse/librechat-admin-panel:1.0.0
NGINX_LOGS_DIR=${DATA_DIR}/logs/nginx
# 固定内网默认值；跨环境共享或扩大访问范围时应更换
ADMIN_PANEL_SESSION_SECRET=ef013d6ecb2a6b82ae36c13620ee1096efaf7209f3ed9a7ad8985c0109b346e2

# ── 默认项：服务间鉴权 ─────────────────────────────────────────────────────
# LibreChat 调用 founder_sales 的固定内网 Bearer Key
FOUNDER_SALES_API_KEY=fa3bb2acb280796d28c2c5a7b32767a7189588244047ee4c706d66fdfeb412cb

# ── 默认项：founder_sales 主智能体 ─────────────────────────────────────────────
FOUNDER_SALES_LOGS_DIR=${DATA_DIR}/logs/founder-sales
FOUNDER_SALES_POSTGRES_DATA_DIR=${DATA_DIR}/founder-sales/postgres
FOUNDER_SALES_POSTGRES_DB=founder_sales
FOUNDER_SALES_POSTGRES_USER=founder_sales
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_AGENT_MODEL=qwen3.6-plus
QWEN_VISIT_MODEL=qwen3.6-plus
QWEN_FALLBACK_MODEL=qwen3.5-plus
QWEN_TASK_MODEL_LITE=qwen3.5-plus
QWEN_SEARCH_MODEL=qwen3.5-plus
# 联网搜索模块返回受控错误时，首次请求后的额外重试次数
QWEN_SEARCH_RETRY_COUNT=2
QWEN_TIMEOUT_SECONDS=60
BUSINESS_TIMEOUT_SECONDS=360

# ── 默认项：企业画像 Tool ──────────────────────────────────────────────────────
COMPANY_PROFILE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COMPANY_PROFILE_LLM_MODEL=qwen3.5-plus
COMPANY_PROFILE_LLM_TIMEOUT_SECONDS=180

# ── 默认项：LibreChat 会话与凭据加密 ────────────────────────────────────────
MONGO_DATA_DIR=${DATA_DIR}/libre/mongodb
LIBRACHAT_UPLOADS_DIR=${DATA_DIR}/libre/uploads
LIBRECHAT_LOGS_DIR=${DATA_DIR}/logs/librechat
MONGODB_LOGS_DIR=${DATA_DIR}/logs/mongodb
# 固定内网默认值；跨环境共享或扩大访问范围时应更换
JWT_SECRET=5c5550bc0a97d77e50db8ecf3823678040521a63dfe59b442124d06b8be798d0
JWT_REFRESH_SECRET=7632b3d429ca81cadbcff771a0b38196f727a6bb5af1d544a7bf265f1c34fefa
CREDS_KEY=55c53052e8b684ca921417a055e6cd4cecf7a3241ddfe95a66124b1226be772a
CREDS_IV=6d8dc08b0a233177f7119126b81ce1c2

# ── 默认项：CRM 网关策略 ─────────────────────────────────────────────────
CRM_TOKEN_MAX_AGE_SECONDS=10
CRM_AUTH_DEBUG_ERRORS=false
# 正式环境必须关闭 LibreChat 原生 Email 登录和注册
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false

# ── 默认项：智能体 RAG ──────────────────────────────────────────────────
# 未准备或不加载 rerank 模型时必须留空
RERANKER_MODEL_PATH=
# 部署固定使用 CPU（CPU 版 torch，见 requirements.txt）
RAG_DEVICE=cpu
