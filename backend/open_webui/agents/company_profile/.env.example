# 服务运行名称前缀：用于容器名和调度器容器定位。
SERVICE_NAME=company-profile
COMPOSE_PROJECT_NAME=company-profile

# 每日访问次数限额（0 = 不限）。生产请按需设置正整数。
DAILY_VISIT_LIMIT=200

# 生产环境从 Harbor 拉取镜像
DEPLOY_BASE_REGISTRY=172.19.52.215:9100/deploy-base/
COMPANY_PROFILE_REGISTRY=172.19.52.215:9100/sales-agents/
BASE_IMAGE_REGISTRY=docker.fzyun.io/

# 基础服务镜像
NGINX_IMAGE=nginx:v0.1.0
POSTGRES_IMAGE=postgres:v0.1.0
REDIS_IMAGE=redis:v0.1.0
API_GATEWAY_IMAGE=api-gateway:v0.1.3
SCHEDULER_IMAGE=scheduler:v0.1.1
MONITOR_IMAGE=monitor:v0.1.5
BACKUP_IMAGE=db-backup:v0.1.1

# 数据库备份目录，默认保存到相对路径 ./data/backups
BACKUP_DIR=./data/backups

# 应用日志目录，默认保存到相对路径 .log
LOG_DIR=./data/.log

# 业务镜像
SERVICE_IMAGE=company-profile-service:v0.1.5
HANDLER_MODULES=handlers.company_profile:CompanyProfileHandler

# API Gateway 回调失败重试配置
CALLBACK_MAX_RETRIES=3
CALLBACK_RETRY_DELAY_SECONDS=2

# API Gateway 允许的任务类型白名单（逗号分隔，空=不限制）
ALLOWED_TASK_TYPES=profile

# 对外入口
PUBLIC_HOST=127.0.0.1
NGINX_HOST_PORT=8088

# 企业画像 LLM 设置
LLM_API_KEY=sk-******
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus
LLM_TIMEOUT_SECONDS=180

# 企业画像 PDF 输出设置
PROFILE_PDF_DOWNLOAD_BASE_URL=http://${PUBLIC_HOST}:${NGINX_HOST_PORT}/api/download
PROFILE_PDF_TEMP_TTL_HOURS=24
PROFILE_PDF_BACKUP_TTL_DAYS=7
PROFILE_PDF_CLEANUP_INTERVAL_SECONDS=3600
# 企业画像 PDF 缓存与备份目录；默认保存到相对路径 ./data/pdf_***
PROFILE_PDF_TEMP_DIR=./data/pdf_temp
PROFILE_PDF_BACKUP_DIR=./data/pdf_backup

# 企业画像完成回调接口，填写实际 KEY/IV
PROFILE_CALLBACK_URL=http://172.19.59.163:8096/api/CompanyProfile/ProfileCallback
PROFILE_CALLBACK_BODY_AES_KEY=''
PROFILE_CALLBACK_BODY_AES_IV=''
PROFILE_CALLBACK_TOKEN_AES_KEY=''
PROFILE_CALLBACK_TOKEN_AES_IV=''
PROFILE_CALLBACK_SERVER_IP=${PUBLIC_HOST}
# 0 表示不启用 requests 客户端超时限制。
PROFILE_CALLBACK_TIMEOUT=0
