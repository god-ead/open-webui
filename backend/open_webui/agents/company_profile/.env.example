# 服务运行名称前缀：用于容器名和调度器容器定位。
SERVICE_NAME=company-profile
COMPOSE_PROJECT_NAME=company-profile

# 生产环境从 Harbor 拉取镜像
DEPLOY_BASE_REGISTRY=172.19.52.215:9100/deploy-base/
COMPANY_PROFILE_REGISTRY=172.19.52.215:9100/sales-agents/company-profile/
BASE_IMAGE_REGISTRY=

# 基础服务镜像
NGINX_IMAGE=nginx:v0.1.0
POSTGRES_IMAGE=postgres:v0.1.0
REDIS_IMAGE=redis:v0.1.0
API_GATEWAY_IMAGE=api-gateway:v0.1.0
SCHEDULER_IMAGE=scheduler:v0.1.0
MONITOR_IMAGE=monitor:v0.1.0
BACKUP_IMAGE=db-backup:v0.1.0

# 业务镜像
SERVICE_IMAGE=company-profile-service:v0.1.0
HANDLER_MODULES=handlers.company_profile:CompanyProfileHandler

# API Gateway 回调失败重试配置
CALLBACK_MAX_RETRIES=3
CALLBACK_RETRY_DELAY_SECONDS=2

# 对外入口
PUBLIC_HOST=127.0.0.1
NGINX_HOST_PORT=8088

# 企业画像 LLM 设置
LLM_API_KEY=*****
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus
LLM_TIMEOUT_SECONDS=180

# 企业画像 PDF 输出设置
PROFILE_PDF_TEMP_DIR=/app/profile-pdf-temp
PROFILE_PDF_BACKUP_DIR=/app/profile-pdf-backup
PROFILE_PDF_DOWNLOAD_BASE_URL=http://${PUBLIC_HOST}:${NGINX_HOST_PORT}/api/download
PROFILE_PDF_TEMP_TTL_HOURS=24
PROFILE_PDF_BACKUP_TTL_DAYS=7
PROFILE_PDF_CLEANUP_INTERVAL_SECONDS=3600
PROFILE_PDF_TEMP_VOLUME=profile_pdf_temp
PROFILE_PDF_BACKUP_VOLUME=profile_pdf_backup
