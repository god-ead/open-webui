# 服务运行名称前缀：用于容器名和调度器容器定位。
SERVICE_NAME=company-profile
COMPOSE_PROJECT_NAME=company-profile

# Harbor 私有仓库地址（本地开发可留空）
HARBOR_REGISTRY=
#172.19.52.215:9100/deploy-base/

# Docker Hub 镜像代理；留空表示直接使用默认镜像代理，非空时末尾必须保留 /
BASE_IMAGE_REGISTRY=

# 框架镜像名称（生产环境会自动拼接 Harbor 前缀）
NGINX_IMAGE=nginx:v0.1.0
POSTGRES_IMAGE=postgres:v0.1.0
REDIS_IMAGE=redis:v0.1.0
API_GATEWAY_IMAGE=api-gateway:v0.1.0
SCHEDULER_IMAGE=scheduler:v0.1.0
MONITOR_IMAGE=monitor:v0.1.0
BACKUP_IMAGE=db-backup:v0.1.0

# 业务镜像名称
SERVICE_IMAGE=company-profile-service:v0.1.0
HANDLER_MODULES=handlers.company_profile:CompanyProfileHandler

# API Gateway 回调失败重试配置（首次请求失败后最多重试 3 次）
CALLBACK_MAX_RETRIES=3
CALLBACK_RETRY_DELAY_SECONDS=2
NGINX_HOST=8088

# Company profile model settings
LLM_API_KEY=*****
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus
LLM_TIMEOUT_SECONDS=180
