###############################################################################
# 企业画像（Company Profile）环境变量模板
#
# 用法：cp .env.example .env，完成【必填】项后启动：
#   docker compose -f docker-compose.yaml up -d
#
#   - .env 已被 gitignore，可存放密钥。
#   - ${VAR} 由 compose 按文件顺序解析，须在被引用之前定义。
#   - *_REGISTRY 与镜像名直接拼接，须以 “/” 结尾；置空则用本地镜像名。
#
# ⚠ 必填项：
#   PUBLIC_HOST                  默认 127.0.0.1 仅本机 -> 本机对外可达 IP/域名
#   LLM_API_KEY                  占位符 sk-****** 未替换 -> LLM 调用失败
#   CALLBACK_BODY_AES_KEY / IV   回调 body 加密，各 16 字节
#   CALLBACK_TOKEN_AES_KEY / IV  回调 token 加密，各 16 字节
###############################################################################

# ── 部署标识 ─────────────────────────────────────────────────────────────────
# 容器名前缀与调度器定位，并作为额度 Redis key 的一部分。
SERVICE_NAME=company-profile
# Compose 项目名，隔离容器/网络/卷。
COMPOSE_PROJECT_NAME=company-profile

# ── 对外入口 ─────────────────────────────────────────────────────────────────
# 【必填】本机对外可达 IP/域名。同时用于回调 token IP 与 PDF 下载地址，回调方/下载方须能访问。
PUBLIC_HOST=127.0.0.1
# Nginx 宿主机端口（容器内固定 80）。
NGINX_HOST_PORT=8088

# ── 数据根目录（推荐修改）────────────────────────────────────────────────────
# 【推荐修改】统一控制备份、日志和 PDF 的数据落盘位置，支持绝对路径或相对路径。
# 相对路径以 docker-compose.yaml 所在目录为基准；修改此项即可整体迁移数据目录。
DATA_DIR=./data

# ── 镜像仓库（生产从 Harbor 拉取，地址须以 “/” 结尾）─────────────────────────
# 基础设施镜像（postgres/redis/nginx/api-gateway/scheduler/monitor/backup）。
DEPLOY_BASE_REGISTRY=172.19.52.215:9100/deploy-base/
# 业务镜像（company-profile-service）。
COMPANY_PROFILE_REGISTRY=172.19.52.215:9100/sales-agents/

# ── 基础服务镜像版本 ─────────────────────────────────────────────────────────
NGINX_IMAGE=nginx:v0.1.0
POSTGRES_IMAGE=postgres:v0.1.0
REDIS_IMAGE=redis:v0.1.0
API_GATEWAY_IMAGE=api-gateway:v0.1.6
SCHEDULER_IMAGE=scheduler:v0.1.2
MONITOR_IMAGE=monitor:v0.1.5
BACKUP_IMAGE=db-backup:v0.1.1

# ── 业务服务 ─────────────────────────────────────────────────────────────────
SERVICE_IMAGE=company-profile-service:v0.1.9
# Worker 任务 Handler，格式 模块:类名，多项逗号分隔。
HANDLER_MODULES=handlers.company_profile:CompanyProfileHandler

# ── 任务限流 ─────────────────────────────────────────────────────────────────
# 每日处理任务上限。0/空=不限；按日累计、跨日清零。
DAILY_VISIT_LIMIT=200
# 额度耗尽后任务放回队列退避：先 10s*2^n 指数退避，≥本值后固定本值秒重试。
DAILY_VISIT_LIMIT_SLEEP_SECONDS=300

# ── LLM ──────────────────────────────────────────────────────────────────────
# 【必填】LLM 密钥，替换占位符。
LLM_API_KEY=sk-******
# OpenAI 兼容接口地址，默认通义千问 DashScope。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus
# LLM 单次请求超时（秒）。
LLM_TIMEOUT_SECONDS=180

# ── API Gateway 任务白名单 ───────────────────────────────────────────────────
# 允许的任务类型，逗号分隔；空=不限。企业画像仅接受 profile。
ALLOWED_TASK_TYPES=profile
# true=提交任务时必须带 callback 地址，否则拒绝提交任务。
CALLBACK_REQUIRED=true

# ── API Gateway 加密回调 ─────────────────────────────────────────────────────
# profile 成功后回调任务请求中的 callback 地址；此处仅配加密参数。
# AES-128-CBC + PKCS7，Base64；body 与 header token 分别用各自 KEY/IV 加密。
# 按当前业务接口约定，企业画像须用 aes_cbc（json 为明文回调）。
CALLBACK_MODE=aes_cbc
# 【必填】回调 body 密钥/IV，各 16 字节（强制校验，不符则回调失败）；含特殊字符用单引号包裹。
CALLBACK_BODY_AES_KEY=''
CALLBACK_BODY_AES_IV=''
# 【必填】回调 token 密钥/IV，各 16 字节。
CALLBACK_TOKEN_AES_KEY=''
CALLBACK_TOKEN_AES_IV=''
# token 明文中的本服务 IP，默认引用 PUBLIC_HOST。
CALLBACK_SERVER_IP=${PUBLIC_HOST}
# 回调 HTTP 超时（秒），默认30s；0=不限。
CALLBACK_TIMEOUT=30
# 回调最大重试次数。
CALLBACK_MAX_RETRIES=3
# 回调失败重试间隔（秒）；实际间隔 = 本值 × 重试序号（默认等待 5/10/15s）。
CALLBACK_RETRY_DELAY_SECONDS=5

# ── PDF 输出与生命周期 ───────────────────────────────────────────────────────
# PDF 下载基础 URL，随结果下发并写入回调。
PROFILE_PDF_DOWNLOAD_BASE_URL=http://${PUBLIC_HOST}:${NGINX_HOST_PORT}/api/download
# 临时文件保留（小时），过期后下载返回 404；文件由清理任务在下一次扫描时删除。
PROFILE_PDF_TEMP_TTL_HOURS=24
# 备份文件保留（天），过期删除。
PROFILE_PDF_BACKUP_TTL_DAYS=7
# 清理任务扫描间隔（秒）。
PROFILE_PDF_CLEANUP_INTERVAL_SECONDS=3600
# PDF 临时/备份目录（宿主机路径，挂载进容器）。
PROFILE_PDF_TEMP_DIR=${DATA_DIR}/pdf_temp
PROFILE_PDF_BACKUP_DIR=${DATA_DIR}/pdf_backup

# ── 数据与日志目录 ───────────────────────────────────────────────────────────
# 数据库备份目录，backup 容器每天 02:00 落盘。
BACKUP_DIR=${DATA_DIR}/backups
# 应用日志目录，多容器共享写入。
LOG_DIR=${DATA_DIR}/.log

###############################################################################
# 以下无法经 .env 配置，需改 compose 文件：
#   - Postgres 密码 postgres:postgres、DATABASE_URL/REDIS_URL、时区 Asia/Shanghai 均硬编码
#   - scheduler 挂载宿主机 /var/run/docker.sock
#   - backup 时刻 BACKUP_TIME="0 2" 硬编码
###############################################################################
